bud: a owl:Ontology ;
    rdfs:label "Morocco state budget ontology"@en,
        "Ontologie du budget de l'Etat marocain"@fr .

bud:allocatedTo a owl:ObjectProperty ;
    rdfs:domain bud:Allocation ;
    rdfs:range bud:Institution .

bud:budgetCode a owl:DatatypeProperty ;
    rdfs:domain bud:Institution ;
    rdfs:range xsd:string .

bud:budgetLine a owl:ObjectProperty ;
    rdfs:domain bud:Allocation ;
    rdfs:range skos:Concept .

bud:budgetYear a owl:DatatypeProperty ;
    rdfs:domain bud:FinanceLaw ;
    rdfs:range xsd:gYear .

bud:chapterCode a owl:DatatypeProperty ;
    rdfs:domain bud:Allocation ;
    rdfs:range xsd:string .

bud:commitmentCredits a owl:DatatypeProperty ;
    rdfs:label "Commitment credits for next years (MAD)"@en,
        "Crédits d'engagement"@fr ;
    rdfs:domain bud:Allocation ;
    rdfs:range xsd:decimal .

bud:inLaw a owl:ObjectProperty ;
    rdfs:range bud:FinanceLaw .

bud:nameKey a owl:DatatypeProperty ;
    rdfs:comment """Name without accents, case and apostrophe differences,
        used to tell a real renaming from a spelling variation."""@en ;
    rdfs:domain bud:OfficialName ;
    rdfs:range xsd:string .

bud:nameOf a owl:ObjectProperty ;
    rdfs:domain bud:OfficialName ;
    rdfs:range bud:Institution .

bud:paymentCredits a owl:DatatypeProperty ;
    rdfs:label "Payment credits (MAD)"@en,
        "Crédits de paiement"@fr ;
    rdfs:domain bud:Allocation ;
    rdfs:range xsd:decimal .

bud:DraftLaw a owl:Class ;
    rdfs:label "Draft finance law (PLF)"@en ;
    rdfs:subClassOf bud:FinanceLaw .

bud:DebtService a skos:Concept ;
    skos:inScheme bud:BudgetNomenclature ;
    skos:prefLabel "Debt service"@en,
        "Service de la dette"@fr .

bud:Investment a skos:Concept ;
    skos:inScheme bud:BudgetNomenclature ;
    skos:prefLabel "Investment"@en,
        "Investissement"@fr .

bud:BudgetNomenclature a skos:ConceptScheme ;
    rdfs:label "Budget nomenclature"@en .

bud:FinanceLaw a owl:Class ;
    rdfs:label "Finance law"@en,
        "Loi de finances"@fr .

bud:VotedLaw a owl:Class ;
    rdfs:label "Voted finance law (LF)"@en ;
    rdfs:subClassOf bud:FinanceLaw .

bud:Operating a skos:Concept ;
    skos:inScheme bud:BudgetNomenclature ;
    skos:prefLabel "Operating"@en,
        "Fonctionnement"@fr .

bud:debt_amortization a skos:Concept ;
    skos:broader bud:DebtService ;
    skos:prefLabel "Principal repayment"@en,
        "Amortissements"@fr .

bud:debt_interest a skos:Concept ;
    skos:broader bud:DebtService ;
    skos:prefLabel "Interest and fees"@en,
        "Intérêts et commissions"@fr .

bud:investment_common_charges a skos:Concept ;
    skos:broader bud:Investment ;
    skos:prefLabel "Investment common charges"@en,
        "Charges communes d'investissement"@fr .

bud:operating_common_charges a skos:Concept ;
    skos:broader bud:Operating ;
    skos:prefLabel "Common charges"@en,
        "Charges communes"@fr .

bud:operating_tax_refunds a skos:Concept ;
    skos:broader bud:Operating ;
    skos:prefLabel "Tax refunds"@en,
        "Remboursements fiscaux"@fr .

bud:operating_unforeseen a skos:Concept ;
    skos:broader bud:Operating ;
    skos:prefLabel "Unforeseen expenses"@en,
        "Dépenses imprévues"@fr .

