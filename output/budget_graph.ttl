bud:Ministry a owl:Class ;
    rdfs:label "Ministry"@en,
        "Ministère"@fr ;
    rdfs:subClassOf bud:Institution .

bud:Institution a owl:Class ;
    rdfs:label "Institution"@en,
        "Département ministériel ou institution"@fr ;
    rdfs:comment """Receives budget credits. Identified by its budget code,
        which stays the same when its name changes."""@en .

<https://github.com/mohamedaminsoumih/morocco-budget-kg/data/institution/13> a bud:Institution,
        bud:Ministry ;
    bud:budgetCode "13" .

<https://github.com/mohamedaminsoumih/morocco-budget-kg/data/law/PLF2027> a bud:DraftLaw ;
    rdfs:label "PLF 2027" ;
    bud:budgetYear "2027"^^xsd:gYear .

<https://github.com/mohamedaminsoumih/morocco-budget-kg/data/law/LF2023> a bud:VotedLaw ;
    rdfs:label "LF 2023" ;
    bud:budgetYear "2023"^^xsd:gYear .

<https://github.com/mohamedaminsoumih/morocco-budget-kg/data/law/LF2024> a bud:VotedLaw ;
    rdfs:label "LF 2024" ;
    bud:budgetYear "2024"^^xsd:gYear .

<https://github.com/mohamedaminsoumih/morocco-budget-kg/data/law/LF2025> a bud:VotedLaw ;
    rdfs:label "LF 2025" ;
    bud:budgetYear "2025"^^xsd:gYear .

<https://github.com/mohamedaminsoumih/morocco-budget-kg/data/law/LF2026> a bud:VotedLaw ;
    rdfs:label "LF 2026" ;
    bud:budgetYear "2026"^^xsd:gYear .

bud:investment a skos:Concept ;
    skos:broader bud:Investment ;
    skos:prefLabel "Investment"@en,
        "Investissement"@fr .

bud:operating_equipment a skos:Concept ;
    skos:broader bud:Operating ;
    skos:prefLabel "Equipment and other expenses"@en,
        "Matériel et dépenses diverses"@fr .

bud:operating_staff a skos:Concept ;
    skos:broader bud:Operating ;
    skos:prefLabel "Staff"@en,
        "Personnel"@fr .

bud:OfficialName a owl:Class ;
    rdfs:label "Official name"@en ;
    rdfs:comment "Name of an institution as written in one finance law."@en .

bud:Allocation a owl:Class ;
    rdfs:label "Budget allocation"@en,
        "Chapitre budgétaire"@fr ;
    rdfs:comment """Credits opened by one finance law, for one institution
        and one budget line."""@en .

